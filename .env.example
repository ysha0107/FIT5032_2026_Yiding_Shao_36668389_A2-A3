# Copy to .env and fill from the EmailJS dashboard (https://dashboard.emailjs.com/admin)
# Account > General > Public Key
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# Email Templates: contact form template (has attachment field, type = Attachment)
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxx
# Bulk email template
VITE_EMAILJS_BULK_TEMPLATE_ID=template_yyyyyyy
# Cloudflare Worker URL (deployed: workers/mindbridge-api)
VITE_WORKER_URL=https://mindbridge-api.ysha0107.workers.dev
