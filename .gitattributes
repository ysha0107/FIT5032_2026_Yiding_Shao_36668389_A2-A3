# Auto detect text files and perform LF normalization
* text=auto

# JavaScript / TypeScript / Vue
*.js    text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Markdown
*.md    text eol=lf

# Config files
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.config.js     text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.eot   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# Lock files (generated)
package-lock.json text eol=lf
